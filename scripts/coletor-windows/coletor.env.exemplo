# coletor.env — configuração do coletor da EDP (P0-13).
# O montar-pacote.sh na VM gera este arquivo já preenchido a partir do .env de
# produção. Para preencher à mão, copie este exemplo para coletor.env.
# NÃO coloque WPA_PROXY: daqui a saída para a EDP é direta.

NODE_ENV=production

# Banco da VM pelo túnel (tunel_banco.ps1 abre 127.0.0.1:15432 -> VM:5432)
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:15432/BANCO
GSEQ_DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:15432/gseq

# Contas da EDP (as mesmas do .env da VM)
WPA_URL=https://edp-wpa-po.azurewebsites.net
WPA_API_URL=https://edp-wpa-web-api.azurewebsites.net
WPA_COMPANY_ID=
WPA_USERNAME=
WPA_PASSWORD=
WPA_USERNAME_SP=
WPA_PASSWORD_SP=
WPA_USERNAME_SP2=
WPA_PASSWORD_SP2=
WPA_ACCOUNTS_DISABLED=

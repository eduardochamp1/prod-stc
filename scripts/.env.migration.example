# ============================================================================
# Variaveis para scripts/migrate-from-supabase.sh
# Copie para .env.migration (gitignored) e preencha
# Uso: source scripts/.env.migration && ./scripts/migrate-from-supabase.sh
# ============================================================================

# ── ORIGEM: Supabase ────────────────────────────────────────────────────────
# Pegue em: Supabase Dashboard -> Settings -> Database -> Connection string
# Use a connection DIRETA (nao a pooled), porta 5432.
# Host tipico: db.<project-ref>.supabase.co
SUPABASE_HOST=db.iyadtjzehhebwojreudz.supabase.co
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_DB=postgres
SUPABASE_PASSWORD=

# ── DESTINO: Postgres local (Fase 1 concluida) ──────────────────────────────
LOCAL_HOST=localhost
LOCAL_PORT=5432
LOCAL_USER=wpa_app
LOCAL_DB=wpa_monitor
LOCAL_PASSWORD=

# Diretorio onde vao dump e logs (opcional, default: /tmp/wpa-migration)
# DUMP_DIR=/var/backups/migration

# =============================================================================
#  WPA Monitor — configuração de ambiente
# =============================================================================
#  Reescrito em 28/08/2026 (auditoria P1-44). A versão anterior documentava 12
#  chaves enquanto o código lia 30 — e as que faltavam incluíam a que IMPEDE O
#  BOOT (CRON_SECRET), as credenciais de uma regional inteira (SJC) e os dois
#  botões destrutivos. Quem seguisse o arquivo montava um .env que não subia, ou
#  que subia perdendo SJC em silêncio.
#
#  Organização: OBRIGATÓRIAS · OPERACIONAL (leia antes de mexer) · AJUSTE FINO ·
#  DIAGNÓSTICO · LEGADO. Para cada chave: o default, o efeito de OMITIR e o
#  efeito de SETAR.
#
#  Regra: se você adicionar uma leitura de env no código, documente aqui no mesmo
#  commit. Vale também pra leitura DINÂMICA (`process.env[nome]`) — três chaves
#  ficaram invisíveis por anos justamente por isso.
# =============================================================================


# ═════════════════════════════════════════════════════════════════════════════
#  1. OBRIGATÓRIAS — sem estas o sistema não sobe ou não funciona
# ═════════════════════════════════════════════════════════════════════════════

# Fonte dos dados.
#   wpa   → servidor interno: busca da API WPA da EDP e grava no Postgres
#   mock  → dados simulados, para desenvolvimento offline e para a suíte
#   (o modo "supabase" do Vercel foi aposentado na Fase 4, 22/07/2026)
# OMITIR → assume "mock". Em produção isso significa painel com dados falsos.
DATA_MODE=wpa

# Postgres local. É a fonte de verdade desde a Fase 4.
# OMITIR → todo acesso a banco lança "DATABASE_URL não configurada"
#          (services/pgShim.js:51). O app sobe e não serve nada.
DATABASE_URL=postgresql://wpa_app:senha@localhost:5432/wpa_monitor

# Assinatura dos JWT de usuário.
# OMITIR → tokens inválidos/inseguros. Troque por string longa e aleatória.
JWT_SECRET=mude-esta-chave-para-algo-seguro-e-longo

# Protege /api/cron/* (disparo manual de snapshot e de consolidação).
# ⚠️ OMITIR COM DATA_MODE=wpa → o processo faz process.exit(1) no BOOT
#    (routes/cron.js:31). É o motivo nº 1 de "montei o .env e não sobe".
# Gere com: openssl rand -hex 32
# ⚠️ Desde 28/08/2026 (P1-43) só é aceito por HEADER:
#      curl -H "Authorization: Bearer $CRON_SECRET" .../api/cron/snapshot
#    O antigo ?secret= na URL foi removido (vazava pra log do PM2, log do
#    Fortinet, histórico do navegador e header Referer).
CRON_SECRET=

# Usuários do painel: usuario:hash:role:regionais
#   role       admin → acesso a /admin e /debug | qualquer outro valor → sem
#   regionais  ALL | GUA | CAC | SJC | ES (grupo GUA+CAC) — separe com |
# Hash: prefira scrypt (node scripts/rehash-users.js). SHA-256 ainda é aceito
# por retrocompatibilidade, mas o boot avisa — ver P1-5, pendência aberta.
AUTH_USERS=admin:HASH_ADMIN:admin:ALL,guarapari:HASH_GUA:user:GUA,cachoeiro:HASH_CAC:user:CAC,saojose:HASH_SJC:user:SJC

# Porta HTTP. OMITIR → 3002.
PORT=3002


# ═════════════════════════════════════════════════════════════════════════════
#  2. CREDENCIAIS DA API WPA (EDP)
#  ⚠️ A conta BLOQUEIA APÓS 5 LOGINS FALHOS. Ver RUNBOOK antes de mexer.
# ═════════════════════════════════════════════════════════════════════════════

WPA_URL=https://edp-wpa-po.azurewebsites.net
WPA_API_URL=https://edp-wpa-web-api.azurewebsites.net

# Conta 'es' — atende os setores DESG, DESC e DEPT (regionais GUA e CAC).
# ⚠️ SEMPRE entre aspas duplas. O dotenv corta o valor no primeiro `#`, e senha
#    com `#` já custou ~40 min de investigação em 14/08/2026 (a senha chegava
#    truncada e a EDP recusava).
WPA_USERNAME=seu_usuario@engelmig.com.br
WPA_PASSWORD="sua_senha"

# ⚠️ ESTAS QUATRO NÃO ESTAVAM DOCUMENTADAS ATÉ 28/08/2026, e são invisíveis a
# qualquer grep por `process.env.NOME`: o código lê via `process.env[acc.userEnv]`
# (services/wpaService.js:413), com os nomes guardados como STRING em ACCOUNTS
# (`:77-79`). Sem elas, o setor DSSJ não coleta — a regional São José dos Campos
# INTEIRA fica sem dados, e o painel mostra "pausada", não "erro".
#
# Conta 'sp' — primária do setor DSSJ (SJC / EDP SP).
WPA_USERNAME_SP=
WPA_PASSWORD_SP=
# Conta 'sp2' — BACKUP do DSSJ. Só entra quando a primária está desativada ou
# com breaker aberto. ⚠️ Em 26/08/2026 foi decidido que SJC roda SEM failover:
# a senha da sp2 (Luan) não seria renovada e a conta está no
# WPA_ACCOUNTS_DISABLED. Ver commit ac0af75 e P1-22.
WPA_USERNAME_SP2=
WPA_PASSWORD_SP2=

# CompanyId da Engelmig na WPA — filtra as equipes da empresa entre todas as
# empreiteiras do setor. OMITIR → usa o ID conhecido embutido no código
# (services/wpaService.js:1234). SETAR ERRADO → o painel fica vazio, ou mostra
# produção de terceiros.
WPA_COMPANY_ID=


# ═════════════════════════════════════════════════════════════════════════════
#  3. OPERACIONAL — leia antes de mexer. Estas duas mudam comportamento de
#     produção e uma delas APAGA DADO.
# ═════════════════════════════════════════════════════════════════════════════

# Kill-switch de conta WPA. CSV de accountKeys (ex.: `sp` ou `sp,es`).
# A conta listada NÃO faz login e os setores dela são PULADOS no snapshot — o
# painel marca a regional como "pausada", não como "falha", e o marcador de saúde
# do ciclo não travava. Uso: credencial revogada ou senha errada, quando não se
# quer NENHUMA tentativa (nem a 1 por 12h do circuit breaker) até resolver com a
# EDP ou com o dono da conta.
# ⚠️ Os dados do período NÃO são recuperáveis depois: a API WPA só serve o ESTADO
#    ATUAL, então não há backfill do que não foi coletado.
# Foi por aqui que a `sp2` saiu de operação em 26/08/2026. Ver RUNBOOK e P1-22.
WPA_ACCOUNTS_DISABLED=

# ⚠️⚠️ DESTRUTIVO. AUSENTE ou 0 = retenção ILIMITADA — que é a decisão de negócio
# de 07/07/2026: manter o histórico bruto pra reprocessar métricas novas
# retroativamente (custo ~16 MB/dia; em 28/08/2026 a tabela `snapshots` tem
# 697.945 linhas e 2,3 GB).
# QUALQUER valor > 0 faz o cron diário APAGAR snapshots mais antigos que N dias, e
# o backfill retroativo daquele período morre junto — sem aviso e sem volta.
# NÃO SETE sem decisão explícita do dono do produto.
SNAPSHOT_RETENTION_DAYS=

# Override da cadeia de contas por setor, para failover manual.
# Nome dinâmico: SECTOR_ACCOUNT_CHAIN_<SETOR> (services/wpaService.js:151) — logo,
# também invisível a grep. Valor: CSV de accountKeys, na ordem de preferência.
# OMITIR → usa a cadeia embutida: DESG/DESC/DEPT = [es], DSSJ = [sp, sp2].
# Exemplo — fazer o DSSJ usar só a backup:
#   SECTOR_ACCOUNT_CHAIN_DSSJ=sp2

# Muda o CÁLCULO da aba Deslocamento: usa a coluna indexada
# `note_details.first_cp_at` em vez de derivar do jsonb.
# ⚠️ Só ligue (=1) DEPOIS de `node -r dotenv/config scripts/migrar-first-cp-at.js`
#    reportar "TEM checkpoint mas sem valor: 0". Antes disso, ligar ESCONDE as
#    notas cujo valor ainda é nulo.
DESLOC_USE_FIRST_CP=


# ═════════════════════════════════════════════════════════════════════════════
#  4. AJUSTE FINO — todas têm default sensato. Mexa com motivo.
# ═════════════════════════════════════════════════════════════════════════════

# ── WPA / rede ───────────────────────────────────────────────────────────────
# Timeout de TODA chamada à EDP, em ms. Default 45000.
# ⚠️ Não baixe de 30000: o cold-start do Azure já foi medido em 25–30s, e cortar
#    resposta legítima faz a equipe aparecer SEM rejeitadas e SEM executadas (o
#    `_safeNotes` devolve bucket vazio em vez de erro). Foi o que aconteceu com o
#    default de 20s em 21/08/2026.
WPA_HTTP_TIMEOUT_MS=45000

# Margem para renovar o token antes de expirar, em ms. Default 1800000 (30 min).
WPA_TOKEN_REFRESH_MARGIN_MS=

# Cooldown do circuit breaker quando a EDP diz "credencial inválida", em MINUTOS.
# Default 720 (12h). Longo de propósito: garante no máximo 1 tentativa por janela,
# então nunca chega às 5 que travam a conta. Ver P1-20.
WPA_INVALID_CRED_COOLDOWN_MIN=

# Cooldown quando a mensagem de erro da EDP é DESCONHECIDA, em MINUTOS.
# Default 20. Abre a partir da 2ª falha consecutiva — antes do P1-32, mensagem
# fora dos dois regexes em português não abria o breaker de jeito nenhum.
WPA_UNKNOWN_ERROR_COOLDOWN_MIN=

# TTL do catálogo de tipos de turno, em ms. Default 43200000 (12h).
WPA_SCALETYPES_TTL_MS=

# ── Regras de negócio (P1-14) ────────────────────────────────────────────────
# Gap máximo, em MINUTOS, para tratar o 1º logon de hoje como RECONEXÃO da última
# sessão de ontem (turno que virou a noite). Default 60.
RECONEXAO_MAX_GAP_MIN=

# Gap máximo, em HORAS, para tratar um novo logon como relogin da mesma sessão.
# Default 0 = SEM LIMITE, que preserva o comportamento histórico. Acima do limite,
# a sessão vira NOVA e o logon de referência passa a ser o dela.
RELOGIN_MAX_GAP_HORAS=

# ── Postgres ─────────────────────────────────────────────────────────────────
# Lidas via `env.NOME` em _buildPoolConfig (services/pgShim.js:48) — por isso não
# aparecem em grep por `process.env.NOME`.
PG_POOL_MAX=10                  # conexões do pool. Default 10.
PG_IDLE_MS=30000                # ociosidade antes de fechar, ms. Default 30000.
PG_STATEMENT_TIMEOUT_MS=60000   # statement_timeout, ms. Default 60000 (P2-6).
# PG_SSL=true                   # só se o Postgres for remoto e exigir SSL.

# ── Rotas / OSRM ─────────────────────────────────────────────────────────────
# Serviço de rota usado no cálculo de deslocamento. Default é o OSRM público.
# Em produção aponta pro Worker da Cloudflare — o Fortinet bloqueia CDN/serviço
# público direto. O ecosystem.config.js cita esta variável como se ela estivesse
# documentada; até 28/08/2026 não estava.
OSRM_HOST=

# Intervalo mínimo entre chamadas ao OSRM, em ms. Default 50.
ROUTING_MIN_INTERVAL_MS=


# ═════════════════════════════════════════════════════════════════════════════
#  5. DIAGNÓSTICO — ligue para investigar, desligue depois
# ═════════════════════════════════════════════════════════════════════════════

# Limiar para logar requisição lenta (evento `slow_request`), em ms. Default 1500.
# 0 desliga o middleware. Também controla o log de fases do getTeams.
# O valor de parâmetro sensível na URL é redigido antes de ir pro log (P1-43).
SLOW_REQUEST_MS=1500

# Nível mínimo de log: debug | info | warn | error.
# OMITIR → info em produção (NODE_ENV=production), debug fora.
LOG_LEVEL=

# =1 imprime HIT/INFLIGHT/MISS de todo cache em memória, com a chave.
# ⚠️ Uma linha por chamada de cache em TODO o app. Ligue pra medir, tire depois.
MEMO_DEBUG=

# NODE_ENV=production troca o log para JSON e sobe o nível mínimo para info.
# NODE_ENV=test desliga o override do dotenv (usado pela suíte).
NODE_ENV=


# ═════════════════════════════════════════════════════════════════════════════
#  6. LEGADO
# ═════════════════════════════════════════════════════════════════════════════

# Cache compartilhado de token WPA em Supabase. Opcional: sem esta chave o token
# vive só em memória e no Postgres local.
SUPABASE_SERVICE_KEY=

# ⚠️ SUPABASE_URL foi REMOVIDA deste arquivo em 28/08/2026: nenhum código a lê
#    (resíduo do P3-8). Documentar variável morta ensina errado.

# ⚠️ WEBHOOK_SECRET foi REMOVIDA em 28/08/2026 junto com o endpoint
#    POST /webhook/deploy (auditoria P2-42). Era um endpoint público que rodava
#    `git pull && npm install && pm2 restart` — com `pm2 restart`, que a regra 4
#    do CLAUDE.md proíbe. Não recrie a chave: se o deploy automático voltar, ele
#    volta desenhado. Ver o comentário no server.js e o item P2-42.
#
#    Pode APAGAR a linha WEBHOOK_SECRET do seu .env — nada mais a lê.

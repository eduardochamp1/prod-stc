# Modo de dados: "mock" para dados simulados, "wpa" para API real
DATA_MODE=wpa

# WPA API (Azure)
WPA_URL=https://edp-wpa-po.azurewebsites.net
WPA_API_URL=https://edp-wpa-web-api.azurewebsites.net
WPA_USERNAME=seu_usuario@engelmig.com.br
WPA_PASSWORD="sua_senha"

# Porta do servidor
PORT=3002

# Banco de dados SQLite
DB_PATH=./data/wpamonitor.db

# false = sem banco (dev), true = com banco (produção)
DB_ENABLED=false

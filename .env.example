# ── MODO DE DADOS ──────────────────────────────────────────────────────────────
# "wpa"      → servidor interno Engelmig (busca direto da API WPA, grava no Supabase)
# "supabase" → Vercel (lê dados do Supabase, sem acesso ao WPA)
# "mock"     → dados simulados para desenvolvimento offline
DATA_MODE=wpa

# ── WPA API (somente no servidor interno) ─────────────────────────────────────
WPA_URL=https://edp-wpa-po.azurewebsites.net
WPA_API_URL=https://edp-wpa-web-api.azurewebsites.net
WPA_USERNAME=seu_usuario@engelmig.com.br
WPA_PASSWORD="sua_senha"

# ── BACKEND DE DADOS ──────────────────────────────────────────────────────────
# Modo recomendado a partir da migracao (Fase 4): Postgres local via DATABASE_URL.
# Se DATABASE_URL estiver setado, services/supabaseClient.js usa o shim local
# (pgShim.js). Senao, cai no fallback do @supabase/supabase-js.
DATABASE_URL=postgresql://wpa_app:senha@localhost:5432/wpa_monitor
# PG_POOL_MAX=10           # max conexoes do pool (default 10)
# PG_IDLE_MS=30000         # timeout de conexao ociosa em ms (default 30s)
# PG_SSL=true              # ative se conectar em Postgres remoto que exige SSL

# ── SUPABASE (legado / fallback durante a transicao) ─────────────────────────
SUPABASE_URL=https://iyadtjzehhebwojreudz.supabase.co
# service_role key — nunca expor no frontend, apenas servidor e Vercel server-side
SUPABASE_SERVICE_KEY=sua_service_role_key

# ── SERVIDOR ──────────────────────────────────────────────────────────────────
PORT=3002

# ── WEBHOOK DE DEPLOY (GitHub → servidor Linux) ───────────────────────────────
# Qualquer string secreta — use a mesma no GitHub e aqui
WEBHOOK_SECRET=sua_chave_secreta_aqui

# ── AUTENTICAÇÃO ──────────────────────────────────────────────────────────────
# Chave secreta para assinar JWT — use uma string longa e aleatória
JWT_SECRET=mude-esta-chave-para-algo-seguro-e-longo

# Usuários no formato: usuario:sha256(senha):role:regional
# Roles:     admin (acesso total) | gua (só Guarapari) | cac (só Cachoeiro)
# Regionais: ALL                  | GUA                | CAC
# Para gerar hash SHA-256: echo -n "suasenha" | sha256sum
AUTH_USERS=admin:HASH_ADMIN:admin:ALL,guarapari:HASH_GUA:gua:GUA,cachoeiro:HASH_CAC:cac:CAC
